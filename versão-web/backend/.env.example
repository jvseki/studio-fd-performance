# Copie este arquivo para "backend/.env" (sem o .example) e preencha.
# O arquivo .env NUNCA vai para o GitHub. Não mande esses valores por chat.

# Supabase > botão "Connect" > Connection String > "Session pooler" (com a senha do banco no lugar de [YOUR-PASSWORD])
DATABASE_URL=

# Supabase > Project Settings > API: "Project URL" e a chave secreta (service_role / secret)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=documentos

# Login: chave longa e aleatória para assinar as sessões (o sistema gera uma se você deixar vazio só no teste local)
SECRET_KEY=

# Primeiro administrador: criado sozinho na primeira vez que o sistema liga com o banco vazio
ADMIN_EMAIL=
ADMIN_SENHA_INICIAL=
