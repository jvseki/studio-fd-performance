{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Studio FD: Gerar atualização",
      "type": "process",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": ["-X", "utf8", "${workspaceFolder}/tools/release.py", "--interactive"],
