# Copie para .env.local (que NÃO vai para o Git) e preencha quando o backend existir.

# Chave PÚBLICA do Mercado Pago (começa com APP_USR- ou TEST-). Pode ficar no frontend.
# Nesta versão, os pagamentos permanecem simulados mesmo com estas variáveis.
# A integração real depende do backend e da confirmação via webhook verificado.
VITE_MP_PUBLIC_KEY=

# Endereço do backend Python (futuro). O Access Token e o Client Secret do
# Mercado Pago ficam SOMENTE lá, nunca neste projeto.
VITE_API_URL=
